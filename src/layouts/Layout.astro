---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Bajo Cero | Ganaste un 5% de descuento',
	description =
		'Escaneaste el QR de Bajo Cero: tenés un 5% de descuento. Sacá una captura y validá tu cupón por WhatsApp. Válido por 48 horas en Río Cuarto.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#eef4fb" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="es_AR" />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

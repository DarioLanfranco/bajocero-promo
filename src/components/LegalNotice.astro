---
import { LEGAL_TEXT } from "../config/business";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p
  class:list={[
    "legal-notice mt-3 border-t border-[#1b365d]/10 pt-2.5 text-center text-[10px] leading-[1.5] text-pretty text-[#6b7280] sm:mt-4 sm:pt-3 sm:text-[11px]",
    className,
  ]}
>
  <strong class="font-semibold text-[#4b5563]">{LEGAL_TEXT.singleUse}</strong>
  {LEGAL_TEXT.scope}{" "}
  <strong class="font-semibold text-[#4b5563]">{LEGAL_TEXT.proof}</strong>
  {LEGAL_TEXT.proofDetail} {LEGAL_TEXT.stacking}
</p>

---
import { COUPON_DURATION_MS } from "../config/business";
import { formatRemaining, splitRemaining } from "../scripts/countdown";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const initialClock = formatRemaining(splitRemaining(COUPON_DURATION_MS));
---

<div
  class:list={[
    "countdown rounded-xl border border-[#0077cc]/15 bg-[#0077cc]/[0.06] px-3.5 py-2.5 text-center transition-colors duration-300",
    className,
  ]}
  data-countdown
  data-state="active"
>
  <p
    class="flex items-center justify-center gap-1.5 text-[9px] font-bold tracking-[0.22em] text-[#1b365d]/80 uppercase"
  >
    <span
      class="countdown__dot h-1.5 w-1.5 rounded-full bg-[#25d366] animate-pulse motion-reduce:animate-none"
      aria-hidden="true"></span>
    <span data-countdown-label class="countdown__label">Tu cupón vence en</span>
  </p>

  <p
    class="countdown__clock mt-0.5 font-mono text-[2rem] leading-none font-bold tracking-tight text-[#1b365d] tabular-nums sm:text-[2.2rem]"
    data-countdown-clock
    role="timer"
    aria-live="off"
    aria-label="Tiempo restante del cupón"
  >
    {initialClock}
  </p>

  <span
    class="sr-only"
    data-countdown-status
    role="status"
    aria-live="polite"></span>
</div>

<style>
  .countdown[data-state="expired"] {
    border-color: #fecaca;
    background-color: #fef2f2;
  }

  .countdown[data-state="expired"] .countdown__dot {
    background-color: #ef4444;
    animation: none;
  }

  .countdown[data-state="expired"] .countdown__label {
    color: #b91c1c;
  }

  .countdown[data-state="expired"] .countdown__clock {
    color: #b42318;
    font-family: inherit;
    font-size: 1.15rem;
    letter-spacing: 0;
  }
</style>

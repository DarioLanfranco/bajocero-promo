---
interface Props {
  /** Dirección del local. TODO: reemplazar por la dirección real. */
  address?: string;
  /** Número internacional sin "+" ni espacios (mismo formato que wa.me). */
  phone?: string;
  /** Número tal como se muestra en pantalla. */
  phoneLabel?: string;
  class?: string;
}

const {
  address = "Av. [Tu Dirección], Río Cuarto",
  phone = "5493586006854",
  phoneLabel = "358 600-6854",
  class: className,
} = Astro.props;

const supportUrl = `https://wa.me/${phone}`;
---

<aside
  class:list={[
    "mt-4 rounded-xl border border-[#1b365d]/10 bg-[#f5f8fc]/90 px-3 py-2.5 text-left short:mt-2 short:px-2.5 short:py-2 compact:mt-2.5 compact:px-2.5 compact:py-2 sm:mt-5 sm:px-4 sm:py-3.5",
    className,
  ]}
  aria-label="Datos de confianza del local"
>
  <ul
    class="space-y-1.5 text-xs leading-[1.45] text-[#42526b] compact:space-y-1 compact:text-[11.5px] sm:space-y-2 sm:text-[13px]"
  >
    <li class="flex items-start gap-2">
      <svg
        class="mt-[0.1em] h-3.5 w-3.5 shrink-0 text-[#0077cc] sm:h-4 sm:w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11Z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
      </svg>
      <span class="font-semibold text-[#1b365d]">{address}</span>
    </li>

    <li class="flex items-start gap-2">
      <svg
        class="mt-[0.1em] h-3.5 w-3.5 shrink-0 text-[#1f9d55] sm:h-4 sm:w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 3l7 3v5.2c0 4.6-3 8.4-7 9.8-4-1.4-7-5.2-7-9.8V6l7-3Z"></path>
        <path d="M9 12l2 2 4-4"></path>
      </svg>
      <span>
        <span class="font-semibold text-[#1b365d]">Atendido por sus dueños</span>
        <span aria-hidden="true"> · </span>
        <span class="font-medium text-[#157347]">Comercio adherido oficial</span>{" "}
        de Bajo Cero
      </span>
    </li>

    <li class="flex items-start gap-2">
      <svg
        class="mt-[0.1em] h-3.5 w-3.5 shrink-0 text-[#25D366] sm:h-4 sm:w-4"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.05-.52-.099-.148-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
      </svg>
      <span>
        WhatsApp oficial:{" "}
        <a
          href={supportUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold whitespace-nowrap text-[#1b365d] underline decoration-[#0077cc]/40 decoration-1 underline-offset-2 transition-colors hover:text-[#0077cc] hover:decoration-[#0077cc] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1b365d]"
          >{phoneLabel}</a
        >
      </span>
    </li>
  </ul>
</aside>

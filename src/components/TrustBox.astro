---
import { BUSINESS, WHATSAPP_SUPPORT_URL } from "../config/business";
import WhatsappIcon from "./ui/WhatsappIcon.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<aside
  class:list={[
    "trust-box mt-4 rounded-xl border border-[#1b365d]/10 bg-[#f5f8fc]/90 px-3 py-2.5 text-left sm:mt-5 sm:px-4 sm:py-3.5",
    className,
  ]}
  aria-label="Datos de confianza del local"
>
  <ul
    class="trust-box__list space-y-1.5 text-xs leading-[1.45] text-[#42526b] sm:space-y-2 sm:text-[13px]"
  >
    <li class="flex items-start gap-2">
      <svg
        class="mt-[0.1em] h-3.5 w-3.5 shrink-0 text-[#0077cc] sm:h-4 sm:w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11Z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
      </svg>
      <span class="font-semibold text-[#1b365d]">{BUSINESS.address}</span>
    </li>

    <li class="flex items-start gap-2">
      <svg
        class="mt-[0.1em] h-3.5 w-3.5 shrink-0 text-[#1f9d55] sm:h-4 sm:w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 3l7 3v5.2c0 4.6-3 8.4-7 9.8-4-1.4-7-5.2-7-9.8V6l7-3Z"></path>
        <path d="M9 12l2 2 4-4"></path>
      </svg>
      <span>
        <span class="font-semibold text-[#1b365d]">Atendido por sus dueños</span>
        <span aria-hidden="true"> · </span>
        <span class="font-medium text-[#157347]">Comercio adherido oficial</span>{" "}
        de {BUSINESS.name}
      </span>
    </li>

    <li class="flex items-start gap-2">
      <WhatsappIcon class="mt-[0.1em] h-3.5 w-3.5 text-[#25D366] sm:h-4 sm:w-4" />
      <span>
        WhatsApp oficial:{" "}
        <a
          href={WHATSAPP_SUPPORT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold whitespace-nowrap text-[#1b365d] underline decoration-[#0077cc]/40 decoration-1 underline-offset-2 transition-colors hover:text-[#0077cc] hover:decoration-[#0077cc] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1b365d]"
          >{BUSINESS.whatsappLabel}</a
        >
      </span>
    </li>
  </ul>
</aside>

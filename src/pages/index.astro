---
import BrandFooter from "../components/BrandFooter.astro";
import CouponCard from "../components/CouponCard.astro";
import PromoBackdrop from "../components/PromoBackdrop.astro";
import Snowfall from "../components/Snowfall.astro";
import { CAMPAIGN } from "../config/business";
import Layout from "../layouts/Layout.astro";
---

<Layout noindex>
  <main
    class="relative flex min-h-dvh w-full flex-col overflow-x-hidden bg-[#eef4fb]"
  >
    <PromoBackdrop />
    <Snowfall />

    <div
      class="promo-content relative z-10 flex min-h-dvh flex-col items-center px-5 pt-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] sm:px-6 sm:pt-8"
    >
      <div
        class="promo-stack flex w-full max-w-2xl flex-1 flex-col items-center justify-center gap-[clamp(0.75rem,2.4vh,1.5rem)] text-center"
      >
        <p
          class="promo-pill reveal inline-flex items-center gap-2 rounded-full border border-white/80 bg-white/60 px-3.5 py-1.5 text-[10px] font-semibold tracking-[0.28em] text-[#1b365d]/75 uppercase shadow-sm backdrop-blur-sm sm:text-[11px]"
        >
          <span aria-hidden="true">❄</span>
          Beneficio exclusivo
          <span aria-hidden="true">❄</span>
        </p>

        <h1 class="reveal reveal-1 flex flex-col items-center">
          <span
            class="promo-kicker text-[clamp(1rem,min(4.2vw,4.8vh),1.55rem)] leading-none font-extrabold tracking-[0.2em] text-[#1b365d] uppercase"
          >
            Ganaste un
          </span>
          <span
            class="promo-amount mt-2 block text-[clamp(2.15rem,min(10.5vw,11vh),4.25rem)] leading-[0.9] font-black tracking-[-0.03em] text-[#0077cc] uppercase text-balance sm:mt-3"
          >
            {CAMPAIGN.discountPercent}% de descuento
          </span>
        </h1>

        <CouponCard />
      </div>

      <BrandFooter />
    </div>
  </main>
</Layout>

<script>
  import { initPromo } from "../scripts/promo";

  initPromo();
</script>

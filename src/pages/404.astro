---
import PromoBackdrop from "../components/PromoBackdrop.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada | Bajo Cero" noindex>
  <main
    class="relative flex min-h-dvh w-full flex-col items-center justify-center overflow-x-hidden px-5 py-8"
  >
    <PromoBackdrop />

    <div
      class="relative z-10 w-full max-w-sm rounded-2xl border border-white/80 bg-white/90 p-6 text-center shadow-xl shadow-[#1b365d]/10 backdrop-blur-md"
    >
      <p
        class="text-[10px] font-semibold tracking-[0.28em] text-[#1b365d]/75 uppercase"
      >
        Bajo Cero
      </p>
      <h1 class="mt-3 text-[2rem] leading-none font-black text-[#0077cc]">
        Página no encontrada
      </h1>
      <p class="mt-3 text-sm leading-snug text-[#4a5568]">
        El enlace que abriste no existe o cambió de dirección.
      </p>
      <a
        href="/"
        class="mt-5 inline-flex w-full items-center justify-center rounded-full bg-[#25D366] px-4 py-3 text-sm leading-none font-bold text-[#0b2e1a] transition-colors hover:bg-[#20bd5a] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1b365d]"
      >
        Volver al cupón
      </a>
    </div>
  </main>
</Layout>
